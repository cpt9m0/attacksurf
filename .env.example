# Copy to .env for local development: `cp .env.example .env`. Never commit .env.
# All settings: src/attacksurf/config.py

ENV=dev                      # dev | test | prod
# Required when ENV=prod: >= 32 random chars, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty in dev: an ephemeral key is generated (sessions reset on restart).
SECRET_KEY=
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://attacksurf:attacksurf@localhost:5432/attacksurf
REDIS_URL=redis://localhost:6379/0

# Trusted proxy hops in front of the app (0 = reached directly). Behind the production
# Cloudflare Tunnel it is 1; see docs/deployment.md.
PROXY_COUNT=0
# Public signups; with `false` only the first account (instance admin) can sign up.
ALLOW_SIGNUP=true
SESSION_LIFETIME_HOURS=12

# Scans (#21): at most this many scan starts per organization per hour, per profile.
SCAN_MAX_STARTS_PER_HOUR=10

LLM_PROVIDER=anthropic       # anthropic | openai_compat
LLM_MODEL=claude-sonnet-5-5
LLM_BASE_URL=                # only for openai_compat (e.g. https://openrouter.ai/api/v1)
LLM_API_KEY=
# Monthly per-org token cap when using the instance LLM_API_KEY (#24).
LLM_MONTHLY_INSTANCE_TOKEN_BUDGET=500000
# Comma-separated hostnames allowed for self-hosted org LLM base URLs (bypasses public-HTTPS check).
LLM_ALLOWED_BASE_HOSTS=

# DNS resolution (#16): public recursive resolvers, comma-separated; timeouts in seconds.
# The resolver addresses must be public IPs (private/loopback resolvers are refused).
DNS_RESOLVERS=1.1.1.1,8.8.8.8
DNS_TIMEOUT_SECONDS=3
DNS_LIFETIME_SECONDS=5
DNS_MAX_CONCURRENCY=20
# Optional offline ip2asn TSV (start end asn country org); empty disables IP enrichment.
IP_ASN_DB_PATH=

# Encryption at rest (ADR 0028, #24): wraps per-artifact keys and org LLM API keys (replaces
# ENCRYPTION_KEY). URL-safe base64 of 32 bytes:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty: artifacts and org API keys can't be stored or read (expired artifacts are still deleted).
# Keep it stable and backed up: losing it makes stored artifacts and org keys unreadable.
APP_ENCRYPTION_KEY=
# Comma-separated previous APP_ENCRYPTION_KEY values for rotating org API key encryption (#24).
APP_ENCRYPTION_OLD_KEYS=
# Uploaded/fetched artifacts (#85). Sizes in bytes; the quota is per organization.
ARTIFACT_MAX_BYTES=268435456         # 256 MiB; 1 - 536870912
ARTIFACT_ORG_QUOTA_BYTES=2147483648  # 2 GiB; at least ARTIFACT_MAX_BYTES
ARTIFACT_RETENTION_HOURS=0           # 0 = delete once analysis completes (24 h at most); max 720
# Ciphertext only; must not be inside (or contain) SANDBOX_ARTIFACT_ROOT below, where the
# plaintext for one sandbox run is staged. The app reads both variables.
ARTIFACT_STORE_ROOT=/var/lib/attacksurf/artifact-store

# Sandboxed analysis (ADR 0016): where the workers reach the sandbox launcher, as
# http://host[:port] only (no credentials, path or https). Unset: every sandbox request is refused.
# SANDBOX_LAUNCHER_URL=http://sandbox-launcher:8791

# sandbox-proxy (ADR 0016). Pass these explicitly in the process environment:
# the proxy does not read .env and must not receive the app's credentials.
# Listener must be reachable only by the launcher on an internal network.
SANDBOX_ARTIFACT_ROOT=/var/lib/attacksurf/artifacts
SANDBOX_IMAGES_LOCK=sandbox-images.lock
SANDBOX_DOCKER_SOCKET=/var/run/docker.sock
SANDBOX_PROXY_HOST=0.0.0.0
SANDBOX_PROXY_PORT=8790
SANDBOX_ALLOW_RUNC=true   # dev/CI fallback to runc when gVisor is missing; refused when ENV=prod

# sandbox-launcher (ADR 0016): environment only, never read from .env by the service
SANDBOX_PROXY_URL=http://sandbox-proxy:8790
SANDBOX_LAUNCHER_HOST=0.0.0.0
SANDBOX_LAUNCHER_PORT=8791
SANDBOX_WALL_TIME_SECONDS=600        # 1-840
SANDBOX_MAX_CONCURRENT_RUNS=2        # 1-16
