# Copy to .env for local development: `cp .env.example .env`. Never commit .env.
# All settings: src/attacksurf/config.py

ENV=dev                      # dev | test | prod
# Required when ENV=prod: >= 32 random chars, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty in dev: an ephemeral key is generated (sessions reset on restart).
SECRET_KEY=
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://attacksurf:attacksurf@localhost:5432/attacksurf
REDIS_URL=redis://localhost:6379/0

# Trusted proxy hops in front of the app (0 = reached directly). Behind the production
# Cloudflare Tunnel it is 1; see docs/deployment.md.
PROXY_COUNT=0
# Public signups; with `false` only the first account (instance admin) can sign up.
ALLOW_SIGNUP=true
SESSION_LIFETIME_HOURS=12

LLM_PROVIDER=anthropic       # anthropic | openai_compat
LLM_MODEL=claude-sonnet-5-5
LLM_BASE_URL=                # only for openai_compat (e.g. https://openrouter.ai/api/v1)
LLM_API_KEY=
