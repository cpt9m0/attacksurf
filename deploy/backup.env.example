# Off-box PostgreSQL backup configuration (issue #29).
# Copy to /etc/attacksurf/backup.env with mode 0600 (root-owned); never commit credentials.
# Used by scripts/backup.sh and scripts/restore.sh via rclone environment configuration.

# Destination rclone path (remote name `backup:` is configured by RCLONE_CONFIG_BACKUP_* below).
BACKUP_REMOTE_PATH=backup:attacksurf-backups/postgres
BACKUP_RETENTION_DAYS=30

# Optional client-side age encryption (recommended). Set to an age public key (`age1...`)
# so dumps are encrypted before leaving the VPS; keep the matching identity key off-box.
BACKUP_AGE_RECIPIENT=

# rclone S3-compatible configuration (Cloudflare R2, AWS S3, Backblaze B2, MinIO, etc.).
# See https://rclone.org/s3/ for provider-specific values.
RCLONE_CONFIG_BACKUP_TYPE=s3
RCLONE_CONFIG_BACKUP_PROVIDER=Cloudflare
RCLONE_CONFIG_BACKUP_ENDPOINT=
RCLONE_CONFIG_BACKUP_REGION=auto
RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID=
RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY=
RCLONE_CONFIG_BACKUP_ACL=private
