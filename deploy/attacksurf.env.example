# Production environment for the attacksurf.dev stack (compose.prod.yaml, issue #132).
# Copy to the host as /etc/attacksurf/attacksurf.env; compose reads it via
# `deploy/attacksurf.env`. See docs/deployment.md. Never commit the filled copy.
# Secrets (DB/Redis passwords, tunnel token) live in separate files under /etc/attacksurf/ and are
# mounted as Docker secrets; do not put them here.

ENV=prod
LOG_LEVEL=INFO

# Required in prod; generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Cloudflare Tunnel -> Caddy means the visitor is already https and is the only forwarded hop.
PROXY_COUNT=1

# Public signups. Leave closed once the instance has real users; the first account can always
# be created (instance admin).
ALLOW_SIGNUP=true
SESSION_LIFETIME_HOURS=12

# Instance LLM (optional). Without a key or model, AI features stay off.
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_API_KEY=

# DNS resolution (#16). Public recursive resolvers only; comma-separated.
DNS_RESOLVERS=1.1.1.1,8.8.8.8
DNS_TIMEOUT_SECONDS=3
DNS_LIFETIME_SECONDS=5
DNS_MAX_CONCURRENCY=20
# Optional offline ip2asn TSV mounted into the worker container.
IP_ASN_DB_PATH=
