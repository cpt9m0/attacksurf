[Unit]
Description=AttackSurf nightly off-box PostgreSQL backup
Documentation=file:///opt/attacksurf/docs/deployment.md
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/attacksurf
StandardOutput=journal
StandardError=journal
SyslogIdentifier=attacksurf-backup
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code 0 /var/lock/attacksurf-backup.lock /opt/attacksurf/scripts/backup.sh
TimeoutStartSec=1h
Nice=15
IOSchedulingClass=idle
